# ============================================================
# QueryNova AI — Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Neon Cloud PostgreSQL Credentials
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
NEON_API_URL=https://host.apirest.region.aws.neon.tech/neondb/rest/v1
AWS_ENDPOINT_URL_S3="https://host.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="us-east-1"

# ------------------------------------------------------------
# Database Connection Preferences
# ------------------------------------------------------------
TARGET_DB_TYPE=postgres
DB_BACKEND_PREFERENCE=postgres

# ------------------------------------------------------------
# LLM Provider & Groq API Key
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
JUDGE_LLM_MODEL=openai/gpt-oss-20b
FALLBACK_LLM_MODEL=qwen/qwen3.8-27b
DATASET_DEFAULT_YEAR=2023

# ------------------------------------------------------------
# Host & Port Configurations
# ------------------------------------------------------------
HOST=127.0.0.1
PORT=8002

# ------------------------------------------------------------
# Operational Boundaries
# ------------------------------------------------------------
ROW_CAP_LIMIT=1000
MAX_REFLECTION_RETRIES=2
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_RESET_TIMEOUT=30
